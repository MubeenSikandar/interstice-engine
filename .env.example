# Interstice Engine Environment Configuration
# Copy this file to .env and update the values as needed

# Database Configuration
DATABASE_URL=postgresql://postgres:root1234@localhost:5432/interstice_engine

# Redis Configuration (for caching and job queues)
REDIS_URL=redis://localhost:6379

# Server Configuration
HOST=0.0.0.0
PORT=3000
RUST_LOG=info

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_ID=your-app-id-here

# GitHub Configuration (if using GitHub integration)
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY_PATH=path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Jira Configuration (if using Jira integration)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your-api-token

# ML Model Configuration
MODEL_CACHE_DIR=./models
EMBEDDING_MODEL_PATH=./models/bert-base-uncased
MAX_SEQUENCE_LENGTH=512
BATCH_SIZE=32

# Training Configuration
TRAINING_INTERVAL_HOURS=1
MIN_TRAINING_EXAMPLES=100
MAX_TRAINING_EXAMPLES=10000
LEARNING_RATE=0.0001
EPOCHS=3

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key-here
PROMETHEUS_ENDPOINT=http://localhost:9090

# Security
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-32-byte-encryption-key-here
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Feature Flags
ENABLE_ML_TRAINING=true
ENABLE_CONTINUOUS_LEARNING=true
ENABLE_USER_FEEDBACK=true
ENABLE_A_B_TESTING=false
