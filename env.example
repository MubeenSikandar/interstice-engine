# ============================================================================
# INTERSTICE ENGINE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure the values for your environment
# 
# Required variables are marked with [REQUIRED]
# Optional variables have default values or can be omitted
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION [REQUIRED]
# ============================================================================

# PostgreSQL database connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/interstice_engine

# Redis connection string (optional, for caching and rate limiting)
# Format: redis://username:password@host:port/database
REDIS_URL=redis://localhost:6379

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server address and port
SERVER_ADDR=0.0.0.0:3000

# Environment (development, staging, production)
ENVIRONMENT=development

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# ============================================================================
# AUTHENTICATION & SECURITY [REQUIRED]
# ============================================================================

# JWT secret key for token signing (generate a strong random key)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT issuer (usually your application name)
JWT_ISSUER=interstice-api

# JWT audience (usually your client application)
JWT_AUDIENCE=interstice-client

# Access token duration in minutes (default: 15)
ACCESS_TOKEN_DURATION_MINS=15

# Refresh token duration in days (default: 30)
REFRESH_TOKEN_DURATION_DAYS=30

# API key header name (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# Request ID header name (default: X-Request-Id)
REQUEST_ID_HEADER=X-Request-Id

# Service secret for internal service communication (optional)
SERVICE_SECRET=your-service-secret

# Maximum login attempts before lockout (default: 5)
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes (default: 15)
LOCKOUT_DURATION_MINS=15

# ============================================================================
# ADMIN USER CONFIGURATION
# ============================================================================

# Default admin user email (default: admin@interstice.com)
ADMIN_EMAIL=admin@interstice.com

# Default admin user password (CHANGE THIS IN PRODUCTION!)
ADMIN_PASSWORD=ChangeMe123!

# ============================================================================
# SLACK INTEGRATION [REQUIRED FOR SLACKBOT]
# ============================================================================

# Slack Bot Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack Signing Secret (from app settings)
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Slack Workspace ID (UUID format)
SLACK_WORKSPACE_ID=92e07a23-a257-4353-a170-534a2019771a

# Slack OAuth Configuration (for app installation)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-domain.com/webhooks/slack/oauth

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

# Rate limit: requests per hour (default: 10000)
RATE_LIMIT_REQUESTS_PER_HOUR=10000

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated list)
# In production, specify your actual domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# CORS max age in seconds (default: 3600)
CORS_MAX_AGE=3600

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Enable analytics (default: true)
ENABLE_ANALYTICS=true

# Analytics buffer size (default: 10000)
ANALYTICS_BUFFER_SIZE=10000

# Analytics flush interval in seconds (default: 30)
ANALYTICS_FLUSH_INTERVAL_SECS=30

# Enable anomaly detection (default: true)
ANALYTICS_ANOMALY_DETECTION=true

# Analytics data retention in days (default: 90)
ANALYTICS_RETENTION_DAYS=90

# Analytics rate limit (default: 1000)
ANALYTICS_RATE_LIMIT=1000

# Analytics sampling rate (0.0 to 1.0, default: 1.0)
ANALYTICS_SAMPLING_RATE=1.0

# ============================================================================
# TIMEOUT CONFIGURATION
# ============================================================================

# Default timeout in seconds (default: 30)
DEFAULT_TIMEOUT_SECS=30

# ML prediction timeout in seconds (default: 60)
ML_PREDICTION_TIMEOUT_SECS=60

# Slack API timeout in seconds (default: 10)
SLACK_API_TIMEOUT_SECS=10

# Circuit breaker configuration
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT_SECS=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# Adaptive timeout configuration
ADAPTIVE_TIMEOUT_ENABLED=true

# ============================================================================
# MACHINE LEARNING CONFIGURATION
# ============================================================================

# ML model cache size (default: 1000)
ML_MODEL_CACHE_SIZE=1000

# ML prediction batch size (default: 10)
ML_PREDICTION_BATCH_SIZE=10

# ML training interval in hours (default: 24)
ML_TRAINING_INTERVAL_HOURS=24

# ML model storage path (default: ./models)
ML_MODEL_STORAGE_PATH=./models

# Enable CUDA acceleration (if available)
ML_CUDA_ENABLED=false

# Enable Metal acceleration (macOS)
ML_METAL_ENABLED=false

# ============================================================================
# PLATFORM INTEGRATIONS
# ============================================================================

# GitHub Integration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Asana Integration
ASANA_TOKEN=your-asana-token

# Jira Integration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@domain.com
JIRA_API_TOKEN=your-jira-api-token

# Microsoft Teams Integration
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password
TEAMS_TENANT_ID=your-teams-tenant-id

# ============================================================================
# WEBHOOK SECURITY
# ============================================================================

# General webhook secret for custom integrations
WEBHOOK_SECRET=your-general-webhook-secret

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus metrics endpoint
PROMETHEUS_ENDPOINT=http://localhost:9090

# Health check interval in seconds (default: 30)
HEALTH_CHECK_INTERVAL_SECS=30

# Enable distributed tracing
ENABLE_TRACING=true

# Tracing sampling rate (0.0 to 1.0, default: 0.01 for production)
TRACING_SAMPLING_RATE=0.01

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=interstice-storage

# Local storage path (fallback)
LOCAL_STORAGE_PATH=./storage

# ============================================================================
# ENCRYPTION CONFIGURATION
# ============================================================================

# Encryption key for sensitive data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable auto-thread responses in Slack
SLACK_AUTO_THREAD_RESPONSES=true

# Enable ML predictions
ENABLE_ML_PREDICTIONS=true

# Enable real-time processing
ENABLE_REAL_TIME_PROCESSING=true

# Enable background workers
ENABLE_BACKGROUND_WORKERS=true

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Enable hot reloading (development only)
HOT_RELOAD=false

# Enable debug mode
DEBUG_MODE=false

# Enable verbose logging
VERBOSE_LOGGING=false

# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================

# Enable production optimizations
PRODUCTION_MODE=false

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# Enable request compression
ENABLE_COMPRESSION=true

# Maximum request body size in bytes (default: 10MB)
MAX_REQUEST_BODY_SIZE=10485760

# ============================================================================
# DATABASE CONNECTION POOL CONFIGURATION
# ============================================================================

# Maximum number of connections in the pool (default: 10)
DB_MAX_CONNECTIONS=10

# Minimum number of connections in the pool (default: 1)
DB_MIN_CONNECTIONS=1

# Connection timeout in seconds (default: 30)
DB_CONNECTION_TIMEOUT=30

# Idle timeout in seconds (default: 600)
DB_IDLE_TIMEOUT=600

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis connection pool size (default: 10)
REDIS_POOL_SIZE=10

# Redis connection timeout in seconds (default: 5)
REDIS_CONNECTION_TIMEOUT=5

# Redis command timeout in seconds (default: 3)
REDIS_COMMAND_TIMEOUT=3

# ============================================================================
# SLACK SPECIFIC CONFIGURATION
# ============================================================================

# Enable Slack Socket Mode (for development)
SLACK_SOCKET_MODE=false

# Slack app token (required for Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token

# Slack retry configuration
SLACK_MAX_RETRIES=3
SLACK_RETRY_DELAY_MS=1000

# Slack cache configuration
SLACK_CACHE_TTL_SECS=300
SLACK_CACHE_MAX_SIZE=1000

# ============================================================================
# ML MODEL CONFIGURATION
# ============================================================================

# Model download URL (for initial setup)
ML_MODEL_DOWNLOAD_URL=https://huggingface.co/models

# Model update check interval in hours (default: 24)
ML_MODEL_UPDATE_INTERVAL_HOURS=24

# Enable model versioning
ML_MODEL_VERSIONING=true

# Model fallback configuration
ML_FALLBACK_MODEL_ENABLED=true

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

# Email configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=notifications@interstice.com

# Slack notification configuration
SLACK_NOTIFICATION_CHANNEL=#interstice-notifications
SLACK_NOTIFICATION_ENABLED=true

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Enable automatic backups
ENABLE_BACKUPS=true

# Backup interval in hours (default: 24)
BACKUP_INTERVAL_HOURS=24

# Backup retention days (default: 30)
BACKUP_RETENTION_DAYS=30

# Backup storage path
BACKUP_STORAGE_PATH=./backups

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Enable IP whitelisting
ENABLE_IP_WHITELIST=false

# IP whitelist (comma-separated)
IP_WHITELIST=127.0.0.1,::1

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable audit logging
ENABLE_AUDIT_LOGGING=true

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Worker thread count (0 = auto-detect)
WORKER_THREADS=0

# Async runtime worker threads (0 = auto-detect)
ASYNC_RUNTIME_WORKERS=0

# Enable connection pooling
ENABLE_CONNECTION_POOLING=true

# Connection pool timeout in seconds
CONNECTION_POOL_TIMEOUT=30

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Enable API documentation
ENABLE_API_DOCS=true

# API documentation path
API_DOCS_PATH=/docs

# Enable GraphQL playground (development only)
ENABLE_GRAPHQL_PLAYGROUND=false

# GraphQL endpoint
GRAPHQL_ENDPOINT=/graphql

# ============================================================================
# TESTING CONFIGURATION
# ============================================================================

# Test database URL (for running tests)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/interstice_test

# Enable test mode
TEST_MODE=false

# Test data cleanup
CLEANUP_TEST_DATA=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log format (json, pretty, compact)
LOG_FORMAT=pretty

# Log file path (optional)
LOG_FILE_PATH=./logs/interstice.log

# Log rotation size in MB
LOG_ROTATION_SIZE_MB=100

# Log retention days
LOG_RETENTION_DAYS=30

# ============================================================================
# METRICS CONFIGURATION
# ============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Metrics port (default: 9090)
METRICS_PORT=9090

# Metrics path (default: /metrics)
METRICS_PATH=/metrics

# Enable custom metrics
ENABLE_CUSTOM_METRICS=true

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Enable caching
ENABLE_CACHE=true

# Cache TTL in seconds (default: 300)
CACHE_TTL_SECS=300

# Cache max size in MB (default: 100)
CACHE_MAX_SIZE_MB=100

# Cache eviction policy (lru, lfu, ttl)
CACHE_EVICTION_POLICY=lru

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
