{
  "format_on_save": "on",
  "tab_size": 4,
  "hard_tabs": false,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": {
          "command": "clippy"
        },
        "cargo": {
          "allFeatures": true
        },
        "rust": {
          "analyzerTargetDir": true
        }
      }
    }
  },
  "file_scan_exclusions": ["**/target", "**/.git", "**/node_modules"]
}
